# Firebase web-app configuration — copy this file to `.env` and fill it in.
# Firebase console > Project settings (malindi-singles-connect) > Your apps > SDK setup.
# `.env` is git-ignored. Only EXPO_PUBLIC_* values are embedded in the app bundle,
# and those are still protected by Firestore/Storage security rules + App Check.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=malindi-singles-connect.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=malindi-singles-connect
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=malindi-singles-connect.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics only)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Supabase Storage (profile photos) --------------------------------------
# Anon/public key ONLY. The SUPABASE_SERVICE_ROLE_KEY must NEVER be placed in
# the mobile app - it lives only on the backend (Malindi-Singles-Connect-backend).
# Photos go to the existing bucket `profile-photos`; Firestore stores only the URL.
EXPO_PUBLIC_SUPABASE_URL=https://ihdelctfpnfjwjubfcww.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
