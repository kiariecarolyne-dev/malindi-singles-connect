{
  "expo": {
    "name": "Malindi Singles Connect",
    "slug": "malindi-singles-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "malindisingles",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F1E",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.ke.malindisinglesconnect"
    },
    "android": {
      "package": "co.ke.malindisinglesconnect",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Malindi Singles Connect needs access to your photos so you can add profile pictures."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "appTagline": "Meet. Match. Connect. Today."
    }
  }
}
