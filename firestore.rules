rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- *
     * Shared helpers                                                     *
     * ---------------------------------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    /** Admin role lives in users/{uid}.role and is only settable by an admin. */
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }

    /**
     * Deterministic pair ids the app builds via helpers.pairKey:
     * `like_{min}__{max}`, `match_{min}__{max}` (double underscore, both
     * uids sorted). Keep this in lockstep with `likeDocId`/`matchDocId` or
     * cross-user notification proofs silently fail.
     */
    function pairId(prefix, a, b) {
      return a < b ? prefix + '_' + a + '__' + b : prefix + '_' + b + '__' + a;
    }

    /**
     * Blocks are stored order-independently as `block_{min}__{max}` (double
     * underscore, matching `blockDocId` in the app). A single document covers
     * both directions, so one lookup proves "these two must not interact".
     */
    function blockedBetween(a, b) {
      return a != b &&
        exists(/databases/$(database)/documents/blocks/
          $(a < b ? 'block_' + a + '__' + b : 'block_' + b + '__' + a));
    }

    /** The other member of a two-uid list (relative to the caller). */
    function otherMember(uids) {
      return uids[0] == uid() ? uids[1] : uids[0];
    }

    /**
     * True when `fromUid` has a real, committed like on the caller. Likes use
     * ONE order-independent doc per pair, so going mutual leaves the stored
     * doc as first-liker (fromUid) -> second-liker (toUid == uid()). This is
     * what makes a match authentic instead of a client-fabricated document.
     */
    function likedMe(fromUid) {
      return exists(/databases/$(database)/documents/likes/$(pairId('like', fromUid, uid()))) &&
        get(/databases/$(database)/documents/likes/$(pairId('like', fromUid, uid()))).data.fromUid == fromUid &&
        get(/databases/$(database)/documents/likes/$(pairId('like', fromUid, uid()))).data.toUid == uid() &&
        get(/databases/$(database)/documents/likes/$(pairId('like', fromUid, uid()))).data.type == 'like';
    }

    /**
     * A conversation may only exist for a real pair: the match is either
     * already committed (opening an existing match's chat) or being created in
     * the same atomic commit (the mutual-like transaction in likeService).
     */
    function matchExistsFor(members) {
      return exists(/databases/$(database)/documents/matches/$(pairId('match', members[0], members[1]))) ||
        existsAfter(/databases/$(database)/documents/matches/$(pairId('match', members[0], members[1])));
    }

    /** Fields no client may ever write on a profile. */
    function profileIsWritable() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['uid', 'gold', 'premium', 'plan', 'role']);
    }

    /* ---------------------------------------------------------------- *
     * Private profile data — date of birth + verification selfie live in *
     * profiles/{uid}/private/data, readable by the owner and admins only. *
     * The public profile keeps a single derived, non-identifying `age`.   *
     * ---------------------------------------------------------------- */

    /** Age (UTC whole years) implied by a timestamp date of birth. */
    function ageFromDob(dob) {
      return request.time.year() - dob.year() -
        ((request.time.month() > dob.month() ||
          (request.time.month() == dob.month() && request.time.day() >= dob.day())) ? 0 : 1);
    }

    /** Date of birth from the private doc, whether already stored or written now. */
    function privateDob(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId)/private/data)
        ? get(/databases/$(database)/documents/profiles/$(userId)/private/data).data.dateOfBirth
        : existsAfter(/databases/$(database)/documents/profiles/$(userId)/private/data)
          ? getAfter(/databases/$(database)/documents/profiles/$(userId)/private/data).data.dateOfBirth
          : null;
    }

    /**
     * The public `age` must be the age implied by the private date of birth.
     * Tolerance of +1 day covers the UTC-vs-local birthday boundary so a
     * genuine client save never fails; it still blocks arbitrary ages.
     */
    function derivedAgeMatches(userId, age) {
      return privateDob(userId) is timestamp &&
        age >= ageFromDob(privateDob(userId)) &&
        age <= ageFromDob(privateDob(userId)) + 1;
    }

    /**
     * Sensitive owner-only fields must never live on the public profile: they
     * may be removed or left untouched, but never (re)introduced or changed
     * through profiles/{uid}. The verification selfie's storage path and
     * metadata are written only by the trusted backend into the private doc.
     */
    function sensitiveFieldsStayPrivate() {
      return !(request.resource.data.keys().hasAny([
          'dateOfBirth', 'verificationSelfie', 'verificationSelfiePath',
          'verificationSelfieBucket', 'verificationSelfieMime',
          'verificationSelfieBytes', 'verificationSelfieUpdatedAt'
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'dateOfBirth', 'verificationSelfie', 'verificationSelfiePath',
          'verificationSelfieBucket', 'verificationSelfieMime',
          'verificationSelfieBytes', 'verificationSelfieUpdatedAt'
        ]));
    }

    /* ---------------------------------------------------------------- *
     * 💛 Gold membership — one source of truth for Gold-only features    *
     * ---------------------------------------------------------------- */

    /**
     * Current entitlement doc (goldEntitlements/{uid}) says isGold AND has not
     * expired. Gold is a lifetime one-time purchase (expiresAt null/absent),
     * but a timed/relabelled entitlement still expires server-side here —
     * the client is never trusted. A non-timestamp `expiresAt` is ignored so a
     * malformed value can never lock out a genuine lifetime entitlement.
     */
    function entitlementIsGold(data) {
      return data.get('isGold', false) == true &&
        !(data.get('expiresAt', null) is timestamp &&
          data.get('expiresAt', null) <= request.time);
    }

    /** Legacy profiles carried `gold.isGold` or `premium.active` inline. */
    function legacyProfileIsGold(data) {
      return data.get('gold', {}).get('isGold', false) == true ||
        data.get('premium', {}).get('active', false) == true;
    }

    /**
     * Server-side Gold check for Gold Circle. `get`/`exists` here are
     * rules calls: they cost reads but never bypass a client's own doc
     * permissions (they are not evaluated against the target's rules).
     * Free members can never satisfy this — they get PERMISSION_DENIED
     * even if they edit the client.
     */
    function isGoldMember() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/goldEntitlements/$(uid())) &&
          entitlementIsGold(get(/databases/$(database)/documents/goldEntitlements/$(uid())).data)) ||
        (exists(/databases/$(database)/documents/profiles/$(uid())) &&
          legacyProfileIsGold(get(/databases/$(database)/documents/profiles/$(uid())).data))
      );
    }

    /* ---------------------------------------------------------------- *
     * users/{uid} — account metadata, role is read-only for its owner    *
     * ---------------------------------------------------------------- */

    match /users/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn() && uid() == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'user';

      allow update: if isAdmin() ||
        (signedIn() && uid() == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.uid == resource.data.uid);

      // Account deletion is a backend/console operation.
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     * profiles/{uid} — public dating profiles                            *
     * ---------------------------------------------------------------- */

    match /profiles/{userId} {
      // Signed-in members read PUBLIC profiles (discover, deck, compatibility).
      // The full date of birth is never here — it stays in the private doc.
      allow get: if signedIn();
      allow list: if signedIn();

      // A public profile may only be created together with its private doc
      // (same atomic batch), so `dateOfBirth` is never exposed and the derived
      // `age` is guaranteed to match the owner-only date of birth.
      allow create: if signedIn() && uid() == userId &&
        request.resource.data.uid == userId &&
        !request.resource.data.keys().hasAny(['gold', 'premium', 'plan', 'role', 'dateOfBirth', 'verificationSelfie']) &&
        request.resource.data.age is int &&
        request.resource.data.age >= 18 &&
        request.resource.data.age <= 120 &&
        derivedAgeMatches(userId, request.resource.data.age);

      // Owners edit themselves, admins run verification/suspension. If the
      // derived age changes it must still equal the private date of birth.
      allow update: if signedIn() && (uid() == userId || isAdmin()) &&
        profileIsWritable() &&
        sensitiveFieldsStayPrivate() &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['age']) ||
          (uid() == userId && derivedAgeMatches(userId, request.resource.data.age))
        );

      allow delete: if isAdmin();

      // Owner + admins may read the date of birth / verification selfie path;
      // the owner is the only client writer, and the date of birth is always
      // required and must describe an adult. Never listable (there is only ever
      // one doc).
      //
      // Verification selfie metadata (private storage path + mime/size) is
      // written EXCLUSIVELY by the trusted backend with Admin credentials
      // (which bypass these rules). Clients are denied from touching it, so a
      // member can never point their private doc at another member's object.
      match /private/{docId} {
        allow get: if signedIn() && (uid() == userId || isAdmin());
        allow list: if false;

        allow create: if signedIn() && uid() == userId && docId == 'data' &&
          request.resource.data.uid == userId &&
          request.resource.data.dateOfBirth is timestamp &&
          ageFromDob(request.resource.data.dateOfBirth) >= 18 &&
          ageFromDob(request.resource.data.dateOfBirth) <= 120 &&
          !request.resource.data.keys().hasAny([
            'verificationSelfie', 'verificationSelfiePath', 'verificationSelfieBucket',
            'verificationSelfieMime', 'verificationSelfieBytes', 'verificationSelfieUpdatedAt'
          ]);

        allow update: if signedIn() && uid() == userId && docId == 'data' &&
          request.resource.data.uid == userId &&
          request.resource.data.dateOfBirth is timestamp &&
          ageFromDob(request.resource.data.dateOfBirth) >= 18 &&
          ageFromDob(request.resource.data.dateOfBirth) <= 120 &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'verificationSelfie', 'verificationSelfiePath', 'verificationSelfieBucket',
            'verificationSelfieMime', 'verificationSelfieBytes', 'verificationSelfieUpdatedAt'
          ]);

        allow delete: if false;
      }
    }

    /* ---------------------------------------------------------------- *
     * likes/{like_{a}_{b}}                                               *
     * ---------------------------------------------------------------- */

    match /likes/{likeId} {
      function involved() {
        return signedIn() &&
          (resource.data.fromUid == uid() || resource.data.toUid == uid());
      }

      // `get` on a like that does not exist yet is part of the match transaction.
      allow get: if signedIn() &&
        (resource == null || resource.data.fromUid == uid() || resource.data.toUid == uid());
      allow list: if involved();

      allow create: if signedIn() &&
        request.resource.data.fromUid == uid() &&
        request.resource.data.type in ['like', 'pass'];

      allow update: if signedIn() &&
        resource.data.fromUid == uid() &&
        request.resource.data.fromUid == uid();

      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- *
     * matches/{match_{a}_{b}}                                            *
     * ---------------------------------------------------------------- */

    match /matches/{matchId} {
      allow get: if signedIn() &&
        (resource == null || uid() in resource.data.uids || isAdmin());
      allow list: if isAdmin() ||
        (signedIn() && uid() in resource.data.uids);

      // A match is only real when the other member already liked the caller;
      // the app creates it inside the mutual-like transaction (`likedMe`).
      // The doc id must be the canonical id for its uids, so other rules can
      // trust `matches/match_{a}__{b}` as proof of that exact pair.
      allow create: if signedIn() &&
        request.resource.data.uids.size() == 2 &&
        request.resource.data.uids[0] != request.resource.data.uids[1] &&
        uid() in request.resource.data.uids &&
        matchId == pairId('match', request.resource.data.uids[0], request.resource.data.uids[1]) &&
        likedMe(otherMember(request.resource.data.uids));

      // Participants flag `blocked` (and only that) when one blocks the other.
      allow update: if signedIn() && uid() in resource.data.uids &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['blocked', 'status']);

      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- *
     * conversations/{id} + messages + typing                             *
     * ---------------------------------------------------------------- */

    match /conversations/{conversationId} {
      allow get: if signedIn() &&
        (resource == null || uid() in resource.data.members || isAdmin());
      allow list: if isAdmin() ||
        (signedIn() && uid() in resource.data.members);

      // A conversation is a real match's chat, never a cold-outreach channel:
      // the pair must have a committed match (or one created in this commit).
      allow create: if signedIn() &&
        request.resource.data.members.size() == 2 &&
        request.resource.data.members[0] != request.resource.data.members[1] &&
        uid() in request.resource.data.members &&
        matchExistsFor(request.resource.data.members);

      // Members send messages (unread counters, summary) but the roster is fixed.
      allow update: if signedIn() && uid() in resource.data.members &&
        request.resource.data.members == resource.data.members;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentMember() {
          return signedIn() &&
            uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }

        allow get, list: if parentMember();
        allow create: if parentMember() &&
          request.resource.data.senderUid == uid();
        // Read receipts only.
        allow update: if parentMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        // "Clear chat" deletes messages, never the conversation itself.
        allow delete: if parentMember();
      }

      match /typing/{typingUid} {
        function parentMember() {
          return signedIn() &&
            uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }

        allow get, list: if parentMember();
        allow write: if parentMember() && typingUid == uid();
      }
    }

    /* ---------------------------------------------------------------- *
     * meetups — plans over public places only                            *
     * ---------------------------------------------------------------- */

    match /meetups/{meetupId} {
      allow get: if signedIn() && (resource == null || uid() in [resource.data.fromUid, resource.data.toUid]);
      allow list: if signedIn() && (resource.data.fromUid == uid() || resource.data.toUid == uid());
      // An invite is only valid between two people who really matched (proven
      // by the committed match doc) and who have not blocked each other — it
      // is never a channel to cold-contact a stranger.
      allow create: if signedIn() &&
        request.resource.data.fromUid == uid() &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != uid() &&
        request.resource.data.status == 'pending' &&
        !blockedBetween(request.resource.data.fromUid, request.resource.data.toUid) &&
        matchExistsFor([request.resource.data.fromUid, request.resource.data.toUid]);
      // Only the receiver answers, and only while neither side has blocked the
      // other — a block freezes any outstanding invite in both directions.
      allow update: if signedIn() && resource.data.toUid == uid() &&
        !blockedBetween(resource.data.fromUid, resource.data.toUid) &&
        request.resource.data.status in ['accepted', 'declined'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'respondedBy']);
      allow delete: if isAdmin();
    }


    /* ---------------------------------------------------------------- *
     * blocks — direction matters for both queries the deck runs          *
     * ---------------------------------------------------------------- */

    match /blocks/{blockId} {
      allow get: if signedIn() &&
        (resource == null || resource.data.uid == uid());

      allow list: if signedIn() &&
        (resource.data.uid == uid() || resource.data.blockedUid == uid());

      allow create: if signedIn() &&
        request.resource.data.uid == uid() &&
        request.resource.data.blockedUid is string;

      allow delete: if signedIn() && resource.data.uid == uid();
    }

    /* ---------------------------------------------------------------- *
     * notifications — inbox is private; cross-user writes are proven     *
     * ---------------------------------------------------------------- */

    function meetupParticipant(meetupId) {
      return uid() == get(/databases/$(database)/documents/meetups/$(meetupId)).data.fromUid ||
        uid() == get(/databases/$(database)/documents/meetups/$(meetupId)).data.toUid;
    }

    /** The other side of a real meetup relative to the caller (its recipient). */
    function meetupOtherUid(meetupId) {
      return get(/databases/$(database)/documents/meetups/$(meetupId)).data.fromUid == uid()
        ? get(/databases/$(database)/documents/meetups/$(meetupId)).data.toUid
        : get(/databases/$(database)/documents/meetups/$(meetupId)).data.fromUid;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.uid == uid();

      allow create: if signedIn() &&
        request.resource.data.uid is string &&
        request.resource.data.title is string &&
        request.resource.data.read == false &&
        (
          // Welcome, boost, system notices people get about themselves.
          request.resource.data.uid == uid() ||
          // The liker proves a real like exists between the pair.
          (request.resource.data.type == 'like' &&
            exists(/databases/$(database)/documents/likes/
              $(pairId('like', uid(), request.resource.data.uid)))) ||
          // A real match exists between the pair.
          (request.resource.data.type == 'match' &&
            exists(/databases/$(database)/documents/matches/
              $(pairId('match', uid(), request.resource.data.uid)))) ||
          // The plan is real, the sender is part of it, and the inbox owner is
          // the other participant (never a third party).
          (request.resource.data.type == 'meetup' &&
            meetupParticipant(request.resource.data.data.meetupId) &&
            request.resource.data.uid == meetupOtherUid(request.resource.data.data.meetupId)) ||
          // Only an admin may push verification results to someone else.
          (request.resource.data.type == 'verification' && isAdmin())
        );

      allow update: if signedIn() && resource.data.uid == uid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- *
     * goldEntitlements/{uid} — readable by its owner, NEVER client-writable *
     * ---------------------------------------------------------------- */

    match /goldEntitlements/{entitlementUid} {
      allow get: if signedIn() && entitlementUid == uid();
      // No list: a query cannot be scoped to "only my own document".
      // No create/update/delete: Gold is granted by the console today and
      // by the M-Pesa callback service later.
      allow write: if false;
    }

    /* ---------------------------------------------------------------- *
     * 💛 goldCirclePosts — the Gold-only community feed                  *
     *                                                                    *
     * Reads AND writes require isGoldMember(): free members are denied   *
     * at the rules level (the client gate is only UX). Gold is never      *
     * self-grantable, so nobody can grant themselves access.              *
     * ---------------------------------------------------------------- */

    match /goldCirclePosts/{postId} {

      allow get, list: if isGoldMember() || isAdmin();

      allow create: if isGoldMember() &&
        request.resource.data.keys().hasAll([
          'authorUid', 'authorName', 'authorAvatar', 'text', 'category',
          'imageUrl', 'imagePath', 'sharedWhatsApp', 'whatsapp',
          'likedBy', 'likeCount', 'commentCount', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorAvatar', 'text', 'category',
          'imageUrl', 'imagePath', 'sharedWhatsApp', 'whatsapp',
          'likedBy', 'likeCount', 'commentCount', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.authorUid == uid() &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() > 0 &&
        request.resource.data.authorName.size() <= 100 &&
        request.resource.data.authorAvatar is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 2000 &&
        // Text-only, photo-only or text + photo (never an empty post).
        (
          request.resource.data.text.size() > 0 ||
          (
            request.resource.data.imageUrl is string &&
            request.resource.data.imageUrl.size() > 0
          )
        ) &&
        request.resource.data.category in ['discussion', 'question', 'experience', 'story', 'photo'] &&
        (request.resource.data.imageUrl == null || request.resource.data.imageUrl is string) &&
        (request.resource.data.imagePath == null || request.resource.data.imagePath is string) &&
        request.resource.data.sharedWhatsApp is bool &&
        (request.resource.data.whatsapp == null ||
          (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 30)) &&
        request.resource.data.likedBy is list &&
        request.resource.data.likedBy.size() == 0 &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isGoldMember() && (
        // 👍 Like / unlike: only the acting uid may enter or leave the
        // array, and likeCount always mirrors likedBy.size(). A block in
        // either direction stops the like entirely.
        (
          !blockedBetween(uid(), resource.data.authorUid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likeCount']) &&
          request.resource.data.likeCount == request.resource.data.likedBy.size() &&
          request.resource.data.likeCount >= 0 &&
          (
            (
              !(uid() in resource.data.likedBy) &&
              uid() in request.resource.data.likedBy &&
              request.resource.data.likedBy.hasAll(resource.data.likedBy) &&
              request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
              request.resource.data.likeCount == resource.data.likeCount + 1
            ) ||
            (
              uid() in resource.data.likedBy &&
              !(uid() in request.resource.data.likedBy) &&
              resource.data.likedBy.hasAll(request.resource.data.likedBy) &&
              request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
              request.resource.data.likeCount == resource.data.likeCount - 1
            )
          )
        ) ||
        // 💬 commentCount moves by exactly ±1 when a comment is added or
        // removed (writeBatch increment), nothing else may change.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['commentCount']) &&
          request.resource.data.commentCount >= 0 &&
          (
            request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount == resource.data.commentCount - 1
          )
        )
      );

      // Authors own their post; admins moderate by removal.
      allow delete: if isAdmin() ||
        (isGoldMember() && resource.data.authorUid == uid());

      match /comments/{commentId} {
        allow get, list: if isGoldMember() || isAdmin();

        allow create: if isGoldMember() &&
          request.resource.data.keys().hasAll([
            'authorUid', 'authorName', 'authorAvatar', 'text', 'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'authorUid', 'authorName', 'authorAvatar', 'text', 'createdAt'
          ]) &&
          request.resource.data.authorUid == uid() &&
          request.resource.data.authorName is string &&
          request.resource.data.authorName.size() > 0 &&
          request.resource.data.authorName.size() <= 100 &&
          request.resource.data.authorAvatar is string &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.createdAt == request.time &&
          exists(/databases/$(database)/documents/goldCirclePosts/$(postId)) &&
          // Respect blocks both ways: a blocked member cannot comment on the
          // blocker's post, and the blocker cannot comment on theirs.
          !blockedBetween(uid(),
            get(/databases/$(database)/documents/goldCirclePosts/$(postId)).data.authorUid);

        // Comments are immutable — edits would rewrite the conversation.
        allow update: if false;

        allow delete: if isAdmin() ||
          (isGoldMember() && resource.data.authorUid == uid());
      }
    }

    /* ---------------------------------------------------------------- *
     * 💛 goldCircleDailyTopics — ONE featured topic per Nairobi day       *
     *                                                                    *
     * The topic text itself is deterministic (shared topic library), so  *
     * only the vote tally lives here. Tally docs hold counts and never    *
     * voter ids; each Gold member's own choice stays in a private         *
     * subcollection vote only they can read.                             *
     * ---------------------------------------------------------------- */

    match /goldCircleDailyTopics/{dayKey} {
      allow get, list: if isGoldMember() || isAdmin();

      // First vote of the day: the tally is created in the same transaction
      // as the voter's own private vote (proven by existsAfter below).
      allow create: if isGoldMember() &&
        request.resource.data.keys().hasOnly(['counts', 'sum', 'updatedAt']) &&
        request.resource.data.counts is list &&
        request.resource.data.counts.size() >= 2 &&
        request.resource.data.counts.size() <= 3 &&
        request.resource.data.sum == 1 &&
        existsAfter(/databases/$(database)/documents/goldCircleDailyTopics/$(dayKey)/votes/$(uid()));

      // Later votes: the tally total rises by exactly one and this member
      // must not already have a vote for the day.
      allow update: if isGoldMember() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['counts', 'sum', 'updatedAt']) &&
        request.resource.data.counts.size() == resource.data.counts.size() &&
        request.resource.data.sum == resource.data.sum + 1 &&
        !exists(/databases/$(database)/documents/goldCircleDailyTopics/$(dayKey)/votes/$(uid())) &&
        existsAfter(/databases/$(database)/documents/goldCircleDailyTopics/$(dayKey)/votes/$(uid()));

      allow delete: if isAdmin();

      // One private, immutable vote per Gold member per day. Nobody can read
      // anyone else's vote, so the tally never leaks who voted for what.
      match /votes/{voterUid} {
        allow get: if isGoldMember() && voterUid == uid();

        allow create: if isGoldMember() &&
          request.auth.uid == voterUid &&
          request.resource.data.keys().hasOnly(['option', 'createdAt']) &&
          request.resource.data.option is int &&
          request.resource.data.option >= 0 &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------------- *
     * payments/{id} — written only by the backend                        *
     * ---------------------------------------------------------------- */

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ---------------------------------------------------------------- *
     * reports — filing is open, the queue is admin-only                  *
     * ---------------------------------------------------------------- */

    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.fromUid == uid() &&
        request.resource.data.status == 'open';

      allow get, list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
