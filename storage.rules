rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos live at profiles/{uid}/{file}.
    // Anyone signed in can view a photo; only the owner may upload or
    // delete their own images, and only images are accepted.
    match /profiles/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Deleting an old photo is still limited to the owner.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
